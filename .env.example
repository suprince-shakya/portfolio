# Public URL of the site (used for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Portfolio

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
MONGODB_URI=mongodb://localhost:27017/portfolio
JWT_SECRET=replace-with-a-long-random-string

# Used only by `npm run seed:admin`
# Quote the password if it contains #, spaces, or $ (e.g. "my#password").
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="replace-with-a-strong-password"

# Defaults to true when NODE_ENV=production. Set to false only when serving
# production mode over plain HTTP (e.g. local Docker on http://localhost).
# AUTH_COOKIE_SECURE=false
